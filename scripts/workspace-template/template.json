{
  "kind": "workspace-template",
  "version": 1,
  "common": [
    ".eslintignore",
    ".eslintrc.js",
    ".gitignore",
    ".prettierignore",
    ".yarnrc.yml",
    "AGENTS.md",
    "DECISIONS.md",
    "LIFECYCLE.md",
    "Makefile",
    "README.md",
    "backstage.json",
    "catalog-info.yaml",
    ".changeset/README.md",
    ".changeset/config.json",
    "tsconfig.json"
  ],
  "roles": {
    "frontend-plugin": [
      "package.json",
      "app-config.yaml",
      "playwright.config.ts",
      "dynamic-plugins.yaml",
      "packages/app",
      "e2e-tests"
    ],
    "backend-plugin": [
      "package.json",
      "app-config.yaml",
      "dynamic-plugins.yaml",
      "packages/backend"
    ]
  }
}
