{
  "name": "@veecode-platform/backstage-plugin-gitlab-pipelines",
  "version": "1.0.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "package.json": [
        "package.json"
      ]
    }
  },
  "keywords": [
    "backstage",
    "gitlab",
    "gitlab pipelines"
  ],
  "backstage": {
    "role": "frontend-plugin",
    "pluginId": "gitlab-pipelines",
    "pluginPackages": [
      "@veecode-platform/backstage-plugin-gitlab-pipelines"
    ]
  },
  "sideEffects": false,
  "scripts": {
    "start": "backstage-cli package start",
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack",
    "export-dynamic": "rhdh-cli plugin export",
    "export-dynamic:clean": "run export-dynamic --clean"
  },
  "dependencies": {
    "@backstage/catalog-model": "^1.7.7",
    "@backstage/core-compat-api": "^0.5.9",
    "@backstage/core-components": "^0.18.8",
    "@backstage/core-plugin-api": "^1.12.4",
    "@backstage/frontend-plugin-api": "^0.15.1",
    "@backstage/plugin-catalog-react": "^2.1.0",
    "@backstage/theme": "^0.7.2",
    "@material-ui/core": "^4.12.2",
    "@material-ui/icons": "^4.9.1",
    "@material-ui/lab": "4.0.0-alpha.61",
    "@veecode-platform/gitlab-pipelines-common": "workspace:*",
    "dayjs": "^1.11.9",
    "react-use": "^17.2.4"
  },
  "devDependencies": {
    "@backstage/cli": "^0.36.0",
    "@backstage/core-app-api": "^1.19.6",
    "@backstage/dev-utils": "^1.1.21",
    "@backstage/frontend-test-utils": "^0.5.1",
    "@backstage/test-utils": "^1.7.16",
    "@red-hat-developer-hub/cli": "1.11.2",
    "@testing-library/jest-dom": "^5.10.1",
    "@testing-library/react": "^12.1.3",
    "@testing-library/user-event": "^14.0.0",
    "@types/node": "*",
    "msw": "^1.0.0"
  },
  "peerDependencies": {
    "react": "^16.13.1 || ^17.0.0 || ^18.0.0",
    "react-dom": "^16.13.1 || ^17.0.0 || ^18.0.0",
    "react-router-dom": "6.0.0-beta.0 || ^6.3.0"
  },
  "files": [
    "dist"
  ]
